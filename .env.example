# Live FastAPI host (Render Web Service)
PORT=8001
SQA_DATA_DIR=
SQA_WORKER_COUNT=1
# onnx = torch-free MiniLM for Render free (512 MB). torch = local desktop.
SQA_EMBEDDING_BACKEND=onnx
SQA_DEFAULT_PROVIDER=gemini
# 0 = do not store visitor Gemini keys on the server (required for the public web app)
SQA_STORE_LLM_KEYS=0
CORS_ORIGINS=*
# Public origin of this API, used to rewrite figure URLs. Example:
# PUBLIC_API_URL=https://sqa-og-api.onrender.com
PUBLIC_API_URL=
